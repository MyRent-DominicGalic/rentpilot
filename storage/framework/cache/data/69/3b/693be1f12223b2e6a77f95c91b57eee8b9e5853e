title = "Default"

[resources]

[baseComponent]

[global sitemap]
handle = "Content\SEO\SiteMap"

[global settings]
handle = "Content\Settings"

[global page_settings]
handle = "Content\PageSettings"

[section]
handle = "Content\Page"

[cookiesBar]

