    <div class="flex flex-col gap-y-8 lg:gap-y-20 py-24">

            {% for key, item in section.sections %}
            {% if key is not odd %}
                <div class="{{ section.container_style }}{{ key is odd and section.use_zigzag ? 'bg-secondary bg-opacity-5' }} flex flex-row gap-3">
